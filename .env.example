# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Cloudflare Turnstile (both required to turn it on; create a widget in the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Existing Postgres. From inside the container, 127.0.0.1 is the container itself, so use the
# NAS/host IP or hostname (e.g. 192.168.0.11), not localhost.
DATABASE_URL=postgresql+psycopg://medform_app:CHANGE_ME@192.168.0.11:5432/medform
# Docker Compose only: host bind address for the web port
#BIND=127.0.0.1:8002
#PUBLIC_BASE_URL=https://medform.swarner.com
