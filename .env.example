# Copy to .env and fill in. Never commit .env.
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Cloudflare Turnstile (both required to turn it on; create a widget in the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://medform_app:CHANGE_ME@127.0.0.1:5432/medform
